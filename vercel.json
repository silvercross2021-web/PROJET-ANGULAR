{
    "buildCommand": "npm run build",
    "outputDirectory": "dist/portfolio/browser",
    "framework": null,
    "rewrites": [
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ],
    "crons": [
        {
            "path": "/api/projects",
            "schedule": "0 12 * * *"
        }
    ]
}